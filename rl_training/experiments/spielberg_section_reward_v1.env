# Spielberg high-speed residual setup with section-curvature reward.
# Edit this file to tune the experiment without long command lines.

MAP_PATH=../f1tenth_gym_ros/maps/Spielberg_map
MAP_EXT=.png
CENTERLINE_CSV=../centerline_tools/centerline_output/raceline_points_smooth.csv
CORNER_CSV=../centerline_tools/centerline_output/corner_key_points_edited.csv

SX=0.0
SY=0.0
STHETA=0.0
STEPS=9000
MAX_EPISODE_STEPS=9000
TARGET_LAP_STEPS=6350

MIN_SPEED=1.0
MAX_SPEED=10.0
RULE_MIN_SPEED_MPS=1.0
RULE_MAX_SPEED_MPS=6.0
MAX_DELTA_SPEED_MPS=4.0
MAX_SPEED_DELTA_PER_STEP_MPS=0.20

CURVATURE_GAIN=2.0
RULE_CURVATURE_LOOKAHEAD_POINTS=3
MODEL_CURVATURE_SHORT_POINTS=10
MODEL_CURVATURE_MID_POINTS=40
MODEL_CURVATURE_LONG_POINTS=80

# New reward: section-average curvature from points 2..40 ahead.
REWARD_CURVATURE_SECTION_START_POINTS=2
REWARD_CURVATURE_SECTION_END_POINTS=40
CURVATURE_SPEED_SECTION_WEIGHT=0.006
TARGET_SPEED_SMOOTHNESS_WEIGHT=0.04
CRASH_PENALTY_VALUE=1500.0
TIMEOUT_PENALTY_VALUE=500.0

ENABLE_BAD_TRACKING_TERMINATION=1
BAD_TRACKING_MIN_STEPS=120
BAD_TRACKING_CTE_THRESHOLD=0.75
BAD_TRACKING_HEADING_THRESHOLD=0.90

# Runtime-style RL residual gate.
ENABLE_RL_GATE=1
RL_GATE_ENABLE_CTE=0.25
RL_GATE_ENABLE_HEADING=0.20
RL_GATE_DISABLE_CTE=0.45
RL_GATE_DISABLE_HEADING=0.35
RL_GATE_ENABLE_COUNT=10
RL_GATE_DISABLE_COUNT=3
RL_GATE_FADE_IN_STEP=0.05
RL_GATE_FADE_OUT_STEP=0.10

# Training randomization.
RANDOM_START_ALONG_CENTERLINE=1
START_LATERAL_NOISE_STD=0.02
START_LATERAL_NOISE_MAX=0.05
START_YAW_NOISE_STD=0.02
START_YAW_NOISE_MAX=0.05
OBS_CTE_NOISE_STD=0.01
OBS_HEADING_NOISE_STD=0.01
OBS_SPEED_NOISE_STD=0.03

# PPO defaults.
LEARNING_RATE=2e-4
N_STEPS=2048
BATCH_SIZE=128
GAMMA=0.995
GAE_LAMBDA=0.95
CLIP_RANGE=0.15
ENT_COEF=0.001
TOTAL_TIMESTEPS=1000000
MODEL_DIR=models
MODEL_NAME=ppo_speed_spielberg_section_reward_v1
MODEL_PATH=models/ppo_speed_spielberg_section_reward_v1.zip
