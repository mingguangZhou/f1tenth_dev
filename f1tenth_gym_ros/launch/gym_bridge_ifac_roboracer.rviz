Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.75
      Class: rviz_default_plugins/Map
      Enabled: true
      Name: IFAC obstacle map
      Topic:
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /map
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: Ego LaserScan
      Size (Pixels): 3
      Style: Flat Squares
      Topic:
        Reliability Policy: Best Effort
        Value: /scan
      Value: true
    - Alpha: 0.8
      Class: rviz_default_plugins/Path
      Color: 255; 170; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.03
      Name: Traffic route
      Topic:
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /moving_agent/reference_path
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Raceline Markers
      Namespaces:
        raceline: true
        raceline_points: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /raceline_markers
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Ultimate Chosen Local Trajectory
      Namespaces:
        ultimate_chosen_local_trajectory: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drive_arbitration_v2/ultimate_chosen_local_trajectory
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /ego_robot_description
      Enabled: true
      Name: Ego
      Visual Enabled: true
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /opp_robot_description
      Enabled: true
      Name: Moving agent
      Visual Enabled: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: IFAC overview
      Scale: 50
      Target Frame: map
      Value: TopDownOrtho (rviz)
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1600
  X: 40
  Y: 30
