#!/usr/bin/env bash

# ROS Foxy's generated setup scripts probe optional unset variables, so this
# command intentionally uses errexit/pipefail without Bash nounset.
set -eo pipefail

SIM_PACKAGES=(
  f1tenth_gym_ros
)

AUTO_PACKAGES=(
  particle_filter
  centerline_tools
  path_following_v2
  reactive_control_v2
  drive_arbitration_v2
  rl_speed_inference
  oudtra_driver_bringup
)

usage() {
  cat <<'EOF'
Usage: f1 <command>

Dependencies:
  deps [--force]  Install ROS dependencies for all managed packages.
                  Run explicitly only after adding a system dependency.

Build:
  build sim       Build simulator package.
  build auto      Build autonomy packages.
  build all       Build both groups.

Run:
  sim [--agents|--no-agents] [ARGS...]
                  Launch IFAC with three fixed obstacles and one moving agent.
  auto [ARGS...]  Launch autonomy stack only.

Inspect:
  status          List ROS nodes and launch processes.
  help            Show this help.

Use `sim --no-agents` to keep the IFAC static obstacles but remove the moving
agent. Each run command accepts normal ROS launch arguments. Press Ctrl+C to
stop a launch and return to the same container shell. Rendering mode comes
from the host-side dk.sh command: GPU by default, or --cpu for software/noVNC.
EOF
}

require_container() {
  if [[ ! -d /sim_ws || ! -f /opt/ros/foxy/setup.bash ]]; then
    echo "The f1 command must be run inside the F1TENTH ROS container." >&2
    echo "Enter it from the host with: ./dk.sh start" >&2
    exit 1
  fi
}

source_ros() {
  cd /sim_ws
  source /opt/ros/foxy/setup.bash
}

source_workspace() {
  source_ros
  if [[ ! -f /sim_ws/install/local_setup.bash ]]; then
    echo "The ROS workspace has not been built yet." >&2
    echo "Run one or both of: f1 build sim, f1 build auto" >&2
    exit 1
  fi
  source /sim_ws/install/local_setup.bash
}

group_packages() {
  case "$1" in
    sim)
      printf '%s\n' "${SIM_PACKAGES[@]}"
      ;;
    auto)
      printf '%s\n' "${AUTO_PACKAGES[@]}"
      ;;
    all)
      printf '%s\n' "${SIM_PACKAGES[@]}" "${AUTO_PACKAGES[@]}"
      ;;
    *)
      echo "Unknown build group: $1 (expected sim, auto, or all)" >&2
      exit 1
      ;;
  esac
}

install_dependencies() {
  local force=false
  local -a packages=()
  local -a package_paths=()
  local package
  local fingerprint
  local state_dir="/var/lib/f1tenth"
  local state_file="${state_dir}/rosdep-packages.sha256"

  case "${1:-}" in
    "")
      ;;
    --force)
      force=true
      ;;
    *)
      echo "Usage: f1 deps [--force]" >&2
      return 2
      ;;
  esac

  if [[ $# -gt 1 ]]; then
    echo "Usage: f1 deps [--force]" >&2
    return 2
  fi

  while IFS= read -r package; do
    packages+=("${package}")
    package_paths+=("src/${package}")
  done < <(group_packages all)

  source_ros

  for package in "${package_paths[@]}"; do
    if [[ ! -f "${package}/package.xml" ]]; then
      echo "Missing ROS package manifest: /sim_ws/${package}/package.xml" >&2
      return 1
    fi
  done

  fingerprint="$({
    printf '%s\n' 'f1-rosdep-schema=1' 'rosdistro=foxy'
    printf '%s\n' "${package_paths[@]}"
    for package in "${package_paths[@]}"; do
      sha256sum "${package}/package.xml"
    done
  } | sha256sum | cut -d ' ' -f 1)"

  if [[ "${force}" == false ]] \
      && [[ -f "${state_file}" ]] \
      && [[ "$(<"${state_file}")" == "${fingerprint}" ]]; then
    echo "ROS dependencies are already up to date."
    return 0
  fi

  echo "Installing ROS dependencies for: ${packages[*]}"
  rosdep install -q -y -r \
    --from-paths "${package_paths[@]}" \
    --ignore-src \
    --skip-keys "ament_python f1tenth_gym_ros"

  mkdir -p "${state_dir}"
  printf '%s\n' "${fingerprint}" > "${state_file}"
  echo "ROS dependency bootstrap complete."
}

build_group() {
  local group="$1"
  local -a packages=()
  local package

  while IFS= read -r package; do
    packages+=("${package}")
  done < <(group_packages "${group}")

  source_ros

  echo "Building: ${packages[*]}"
  colcon build --symlink-install --packages-select "${packages[@]}"

  echo
  echo "Build complete. Run with: f1 ${group}"
}

run_sim() {
  local launch_file="ifac_roboracer_moving_agent_launch.py"
  local requested_mode=""
  local parse_options=true
  local -a launch_args=()
  local argument

  for argument in "$@"; do
    if [[ "${parse_options}" == true ]]; then
      case "${argument}" in
        --agents)
          if [[ "${requested_mode}" == "no-agents" ]]; then
            echo "Cannot combine --agents and --no-agents." >&2
            return 2
          fi
          requested_mode="agents"
          ;;
        --no-agents)
          if [[ "${requested_mode}" == "agents" ]]; then
            echo "Cannot combine --agents and --no-agents." >&2
            return 2
          fi
          requested_mode="no-agents"
          launch_file="gym_bridge_launch.py"
          ;;
        --)
          parse_options=false
          ;;
        *)
          launch_args+=("${argument}")
          ;;
      esac
    else
      launch_args+=("${argument}")
    fi
  done

  if [[ "${requested_mode}" == "no-agents" ]]; then
    local has_config_override=false
    local has_rviz_override=false
    for argument in "${launch_args[@]}"; do
      if [[ "${argument}" == config_file:=* ]]; then
        has_config_override=true
      elif [[ "${argument}" == rviz_config:=* ]]; then
        has_rviz_override=true
      fi
    done
    if [[ "${has_config_override}" == false ]]; then
      if [[ "${has_rviz_override}" == false ]]; then
        launch_args=(
          "config_file:=/sim_ws/src/f1tenth_gym_ros/config/sim_ifac_roboracer_obstacles.yaml"
          "rviz_config:=/sim_ws/src/f1tenth_gym_ros/launch/gym_bridge_ifac_roboracer.rviz"
          "${launch_args[@]}"
        )
      else
        launch_args=(
          "config_file:=/sim_ws/src/f1tenth_gym_ros/config/sim_ifac_roboracer_obstacles.yaml"
          "${launch_args[@]}"
        )
      fi
    fi
  fi

  source_workspace
  configure_rendering
  ros2 launch f1tenth_gym_ros "${launch_file}" "${launch_args[@]}"
}

run_auto() {
  source_workspace
  ros2 launch oudtra_driver_bringup full_stack_sim_launch.py "$@"
}

configure_rendering() {
  case "${F1TENTH_RENDER_MODE:-gpu}" in
    gpu)
      unset LIBGL_ALWAYS_SOFTWARE
      ;;
    cpu)
      export LIBGL_ALWAYS_SOFTWARE=1
      ;;
    *)
      echo "Unknown F1TENTH_RENDER_MODE: ${F1TENTH_RENDER_MODE}" >&2
      exit 1
      ;;
  esac
}

show_status() {
  source_workspace
  echo "ROS nodes:"
  ros2 node list 2>/dev/null || true
  echo
  echo "ROS launch processes:"
  pgrep -af 'ros2 launch' || true
}

main() {
  require_container

  case "${1:-help}" in
    deps)
      shift
      install_dependencies "$@"
      ;;
    build)
      build_group "${2:-all}"
      ;;
    sim)
      shift
      run_sim "$@"
      ;;
    auto)
      shift
      run_auto "$@"
      ;;
    status | ps)
      show_status
      ;;
    help | -h | --help)
      usage
      ;;
    *)
      echo "Unknown command: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
